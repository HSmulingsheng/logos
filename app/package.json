{
  "name": "logos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "古希腊语学习平台：分级词书 · 语法闯关 · 宗教/哲学/文学/历史四体裁阅读 · 神经语音",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-espeak.mjs && node scripts/sync-neural.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sw": "node scripts/build-sw.mjs",
    "icons": "python3 scripts/make_icons.py",
    "serve": "node scripts/serve.mjs 4178 --open",
    "smoke": "node scripts/smoke.mjs http://127.0.0.1:4178/ /tmp/greek-smoke 60",
    "desktop": "electron desktop/main.cjs",
    "desktop:bundle": "node desktop/bundle.mjs",
    "desktop:test": "node desktop/launch-test.mjs",
    "desktop:selftest": "node_modules/electron/dist/Electron.app/Contents/MacOS/Electron desktop/selftest.cjs --no-sandbox --disable-gpu",
    "test:offline": "node scripts/offline-test.mjs http://127.0.0.1:4178/ /tmp/greek-offline",
    "test:e2e": "node scripts/smoke.mjs http://127.0.0.1:4178/ /tmp/greek-smoke 60",
    "deploy:make": "node scripts/make-deploy.mjs",
    "share": "node scripts/share.mjs",
    "test:grammar": "esbuild scripts/grammar-selftest.ts --bundle --platform=node --format=esm --outfile=/tmp/gs.mjs --log-level=error && node /tmp/gs.mjs",
    "espeak:sync": "node scripts/sync-espeak.mjs",
    "test:sentence": "node scripts/sentence-audio-test.mjs",
    "neural:sync": "node scripts/sync-neural.mjs",
    "test:neural": "node scripts/neural-test.mjs",
    "test:translit": "esbuild scripts/translit-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/translit.mjs --log-level=error && node node_modules/.cache/translit.mjs",
    "test:input": "node scripts/input-test.mjs",
    "desktop:verify": "node desktop/verify-app.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^40.0.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.64.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
